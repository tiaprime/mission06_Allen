@{
}

 @model List<MovieForm>

<h1 class=" ">See Movies</h1>

<table class="table table-bordered">
	<thead class="fw-Bold">
		<tr>
			<td><b>Category</b></td>
			<td><b>Title</b></td>
			<td><b>Year</b></td>
			<td><b>Director</b></td>
			<td><b>Rating</b></td>
			<td><b>Edited</b></td>
			<td><b>Lent To</b></td>
			<td><b>Copied to Plex</b></td>
			<td><b>Notes</b></td>
		</tr>

	</thead>

	@foreach (var x in Model) //loop through the list of movies
	{ 
		<tbody>
			<tr>
			<td>@x.Category?.CategoryName</td>
			<td>@x.Title</td>
			<td>@x.Year</td>
			<td>@x.Director</td>
			<td>@x.Rating</td>
			<td>@x.Edited</td>
			<td>@x.LentTo</td>
			<td>@x.CopiedToPlex</td>
			<td>@x.Notes</td>

				<td><a class="btn btn-info" asp-controller="Home" asp-action="Edit" asp-route-id="@x.MovieId">Edit</a></td>
				<td><a class="btn btn-outline-danger" asp-controller="Home" asp-action="Delete" asp-route-id="@x.MovieId">Delete</a></td>
			</tr>

		</tbody>
	}

</table>
@{
}
@model MovieForm


<h2>Confirm the Movie to Delete</h2>
<h3>@Model.Title (@Model.Year)</h3>

<form method="Post">

	<input type="hidden" asp-for="MovieId" />

	<button type="submit" class="btn btn-danger">Delete</button>
	<a class="btn btn-info" asp-controller="Home" asp-action="SeeMovies">Cancel</a>
</form>